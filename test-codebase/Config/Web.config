<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- SECRETS - Vulnerable: Hardcoded connection string -->
    <add name="DefaultConnection" 
         connectionString="Server=prod-db.company.com;Database=AppDB;User Id=admin;Password=SuperSecret123!" 
         providerName="System.Data.SqlClient" />
    
    <!-- SECRETS - Vulnerable: Another connection string -->
    <add name="ReportingDB"
         connectionString="Data Source=reporting.internal;Initial Catalog=Reports;uid=sa;pwd=P@ssw0rd" />
  </connectionStrings>
  
  <appSettings>
    <!-- SECRETS - Vulnerable: API keys -->
    <add key="ApiKey" value="sk-1234567890abcdefghijklmnop" />
    <add key="jwt-secret" value="MyVeryLongJwtSecretKeyThatShouldNotBeHere123456" />
    
    <!-- Config settings (not secrets) -->
    <add key="PageSize" value="25" />
    <add key="EnableCache" value="true" />
  </appSettings>

  <system.web>
    <!-- CONFIG - Vulnerable: Custom errors off -->
    <customErrors mode="Off" />
    
    <!-- CONFIG - Vulnerable: Request validation disabled -->
    <pages validateRequest="false" />
    
    <!-- These are configuration, not code vulnerabilities -->
    <machineKey validation="SHA1" />
    <membership hashAlgorithmType="SHA1" />
  </system.web>
  
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="30000000" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
